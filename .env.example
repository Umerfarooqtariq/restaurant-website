# Public site URL used for canonical links, Open Graph, and the sitemap.
# Example: https://khanbaba.example
SITE_URL=

# Fixed administrator. Never commit the real values.
ADMIN_USERNAME=
# bcrypt hash from: npm run hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=
# At least 8 characters. Longer is safer. Used to sign the session cookie.
SESSION_SECRET=

# GitHub fine-grained or classic token with read/write access to this repository's contents.
# Used only by Netlify Functions. Never expose it to the browser.
GIT_PROVIDER_TOKEN=
# owner/repository
GIT_REPOSITORY=
GIT_BRANCH=main

# Optional. Set to "github" to test GitHub saves from `netlify dev`.
# Leave unset locally to save into the project files instead.
PERSISTENCE=
