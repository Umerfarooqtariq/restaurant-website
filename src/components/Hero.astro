---
import { placeLabel, restaurant } from "../lib/content";
const place = placeLabel();
const intro = restaurant.description.trim() || (place ? `Restaurant in ${place}.` : "");
---

<section class="hero">
  <div class="hero-media" data-parallax>
    {restaurant.heroImage ? (
      <img src={restaurant.heroImage} alt="" width="1600" height="2000" fetchpriority="high" />
    ) : (
      <svg class="hero-art" viewBox="0 0 800 900" aria-hidden="true">
        <defs>
          <radialGradient id="glow" cx="60%" cy="40%" r="50%">
            <stop offset="0%" stop-color="#d4b483" stop-opacity="0.35" />
            <stop offset="100%" stop-color="#110d0b" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="800" height="900" fill="url(#glow)" />
        <path d="M470 760 V250 C470 80 760 80 760 250 V760" fill="none" stroke="#d4b483" stroke-opacity="0.7" stroke-width="2" />
        <path d="M520 760 V300 C520 150 710 150 710 300 V760" fill="none" stroke="#d4b483" stroke-opacity="0.35" stroke-width="1.5" />
        <circle class="float" cx="620" cy="210" r="18" fill="none" stroke="#d4b483" />
        <path d="M620 250 L636 278 L620 306 L604 278 Z" fill="#d4b483" fill-opacity="0.8" />
      </svg>
    )}
    <div class="hero-shade"></div>
  </div>
  <div class="wrap hero-copy">
    {place && <p class="eyebrow">{place}</p>}
    <h1>{restaurant.name}</h1>
    {restaurant.tagline && <p class="tagline">{restaurant.tagline}</p>}
    {intro && <p class="lede">{intro}</p>}
    <div class="hero-actions">
      <a class="btn btn-gold" href="/menu">View Menu</a>
      <button class="btn btn-ghost" type="button" data-order>Order Now</button>
    </div>
  </div>
</section>
