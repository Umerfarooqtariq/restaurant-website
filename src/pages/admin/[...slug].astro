---
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/outfit/latin-400.css";
import "@fontsource/outfit/latin-500.css";
import AdminApp from "../../admin/AdminApp";
import "../../admin/admin.css";

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: "login" } },
    { params: { slug: "restaurant" } },
    { params: { slug: "about" } },
    { params: { slug: "hours" } },
    { params: { slug: "contact" } },
    { params: { slug: "menu" } },
    { params: { slug: "gallery" } },
    { params: { slug: "branding" } },
    { params: { slug: "settings" } },
  ];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Khan Baba Admin</title>
  </head>
  <body class="admin-body">
    <p id="admin-fallback" class="admin-fallback">Loading admin…</p>
    <noscript><p class="admin-fallback">JavaScript is required to use the admin.</p></noscript>
    <AdminApp client:only="react" />
  </body>
</html>
