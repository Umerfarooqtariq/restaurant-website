---
import BaseLayout from "../layouts/BaseLayout.astro";
import { restaurant } from "../lib/content";
---

<BaseLayout title={`Page not found | ${restaurant.name}`} description="This page could not be found.">
  <div class="wrap page-hero">
    <p class="eyebrow">404</p>
    <h1>This page is not on the menu.</h1>
    <p class="lede">The link may be old, or the page may have moved.</p>
    <div class="stack">
      <a class="btn btn-gold" href="/">Back home</a>
      <a class="btn btn-ghost" href="/menu">View menu</a>
    </div>
  </div>
</BaseLayout>
